# PORT DE CONNEXION
PORT=4000

# MODE DEVELOPPEMENT
NODE_ENV=development

# CONFIGURATION BASE DE DONNEE
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=colo-koo
DB_PORT=3306

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# URL de l'application frontend (utilisée dans les liens de confirmation)
APP_BASE_URL=http://localhost:3000

# E-MAIL SMTP (laisser les valeurs d'exemple jusqu'à la configuration du fournisseur)
# Gmail : SMTP_HOST=smtp.gmail.com, SMTP_PORT=587 et utiliser un mot de passe d'application.
# Après avoir modifié le SMTP, redémarrer le backend.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your-email@example.com
SMTP_PASSWORD=your-smtp-app-password
MAIL_FROM=Coloc'KOO <your-email@example.com>

# JWT
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRY=24h

# COFFRE MOT DE PASSE (affichage du mot de passe en clair par son proprietaire)
# Cle AES-256 : 64 caracteres hex. Generer avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Sans cette cle, la fonctionnalite est simplement inactive.
PASSWORD_VAULT_KEY=
