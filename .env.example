# PORT DE CONNEXION
PORT=4000

# MODE DEVELOPPEMENT
NODE_ENV=development

# CONFIGURATION BASE DE DONNEE
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=colo-koo
DB_PORT=3306

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# URL de l'application frontend (utilisée dans les liens de confirmation)
APP_BASE_URL=http://localhost:3000

# E-MAIL SMTP (Brevo recommandé pour les e-mails transactionnels)
# Dans Brevo, créer et authentifier sarintany-coloc.com, puis utiliser le login SMTP et
# la clé SMTP du compte (pas la clé API). Ne pas mettre de secret réel dans ce fichier.
# Après avoir modifié le SMTP, redémarrer le backend.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_EMAIL=your-brevo-smtp-login
SMTP_PASSWORD=your-brevo-smtp-key
MAIL_FROM_ADDRESS=your-verified-sender@sarintany-coloc.com
MAIL_FROM_NAME=Coloc'KOO
# Compatibilite avec l'ancienne configuration : MAIL_FROM=Coloc'KOO <adresse-verifiee@domaine>

# JWT
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRY=24h

# COFFRE MOT DE PASSE (affichage du mot de passe en clair par son proprietaire)
# Cle AES-256 : 64 caracteres hex. Generer avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Sans cette cle, la fonctionnalite est simplement inactive.
PASSWORD_VAULT_KEY=
